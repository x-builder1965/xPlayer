{
  "name": "xplayer",
  "version": "6.09.0",
  "description": "xPlayer - Multimedia Player",
  "main": "main.js",
  "author": "x-builder",
  "license": "MIT",
  "homepage": "https://github.com/x-builder1965/xPlayer",
  "scripts": {
    "start": "chcp 65001 && electron .",
    "build": "electron-builder --win",
    "dist": "electron-builder --win --x64 --config.compression=maximum",
    "dist:32": "electron-builder --win --ia32",
    "dist:portable": "electron-builder --win --x64 --target portable",
    "publish": "electron-builder --win --publish always",
    "sign": "electron-builder --win --x64 --config.cscLink=authenticode.pfx --config.cscKeyPassword=%CSC_KEY_PASSWORD%"
  },
  "devDependencies": {
    "electron": "^38.8.4",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "audiomotion-analyzer": "^4.5.4",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "trash": "^10.0.0"
  },
  "build": {
    "appId": "com.xbuilder.xplayer",
    "productName": "xPlayer",
    "copyright": "Copyright © 2025- x-builder",
    "asar": true,
    "asarUnpack": [
      "**/ffmpeg-static/**",
      "**/*.node"
    ],
    "compression": "maximum",
    "directories": {
      "output": "dist-win"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "style.css",
      "index.html",
      "index_helpTable.html",
      "index_changelog.html",
      "renderer_declarat.js",
      "renderer_initializ.js",
      "renderer_event.js",
      "renderer_helper.js",
      "control_prev.png",
      "control_play.png",
      "control_pause.png",
      "control_next.png",
      "xPlayer.ico",
      "xPlayer.png",
      "xPlayer.gif",
      "wallpaper.jpg",
      "README.md",
      "**/*"
    ],
    "win": {
      "icon": "xPlayer.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": true,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "xPlayer",
      "menuCategory": "Multimedia",
      "installerIcon": "xPlayer.ico",
      "uninstallerIcon": "xPlayer.ico",
      "installerHeaderIcon": "xPlayer.ico",
      "include": "build/installer.nsh",
      "language": 1041,
      "warningsAsErrors": false,
      "installerLanguages": [
        "ja_JP"
      ]
    },
    "fileAssociations": [
      {
        "ext": "mp4",
        "name": "MP4 Video File",
        "description": "MP4 動画ファイル",
        "mimeType": "video/mp4",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "WebM Video File",
        "description": "WebM 動画ファイル",
        "mimeType": "video/webm",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "ogg",
        "name": "OGG Video File",
        "description": "OGG 動画ファイル",
        "mimeType": "video/ogg",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "QuickTime Video File",
        "description": "QuickTime 動画ファイル",
        "mimeType": "video/quicktime",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "m4v",
        "name": "M4V Video File",
        "description": "M4V 動画ファイル",
        "mimeType": "video/x-m4v",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "Matroska Video File",
        "description": "Matroska 動画ファイル",
        "mimeType": "video/x-matroska",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "mp3",
        "name": "MP3 Audio File",
        "description": "MP3 音声ファイル",
        "mimeType": "audio/mpeg",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "wav",
        "name": "WAV Audio File",
        "description": "WAV 音声ファイル",
        "mimeType": "audio/wav",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "flac",
        "name": "FLAC Audio File",
        "description": "FLAC 音声ファイル",
        "mimeType": "audio/flac",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "ogg",
        "name": "OGG Audio File",
        "description": "OGG 音声ファイル",
        "mimeType": "audio/ogg",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "oga",
        "name": "OGG Audio File",
        "description": "OGG 音声ファイル",
        "mimeType": "audio/ogg",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "m4a",
        "name": "M4A Audio File",
        "description": "M4A 音声ファイル",
        "mimeType": "audio/mp4",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "aac",
        "name": "AAC Audio File",
        "description": "AAC 音声ファイル",
        "mimeType": "audio/aac",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "opus",
        "name": "Opus Audio File",
        "description": "Opus 音声ファイル",
        "mimeType": "audio/opus",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "wma",
        "name": "WMA Audio File",
        "description": "WMA 音声ファイル",
        "mimeType": "audio/x-ms-wma",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "aiff",
        "name": "AIFF Audio File",
        "description": "AIFF 音声ファイル",
        "mimeType": "audio/aiff",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "aif",
        "name": "AIFF Audio File",
        "description": "AIFF 音声ファイル",
        "mimeType": "audio/aiff",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "alac",
        "name": "ALAC Audio File",
        "description": "ALAC 音声ファイル",
        "mimeType": "audio/x-alac",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "ape",
        "name": "Monkey's Audio File",
        "description": "Monkey's Audio 音声ファイル",
        "mimeType": "audio/x-ape",
        "icon": "xPlayer.ico",
        "role": "Viewer"
      },
      {
        "ext": "xpj",
        "name": "xPlayer Project File",
        "description": "xPlayer 設定ファイル",
        "mimeType": "application/x-xplayer-project",
        "icon": "xPlayer.ico",
        "role": "Editor"
      },
      {
        "ext": "amppl",
        "name": "xPlayer Playlist",
        "description": "xPlayer プレイリスト",
        "mimeType": "application/x-xplayer-playlist",
        "icon": "xPlayer.ico",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "xplayer",
        "schemes": [
          "xplayer"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "extra/xPlayer_install.reg",
        "to": "xPlayer_install.reg"
      }
    ]
  }
}
